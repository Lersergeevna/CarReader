import collection.MyArrayList;
import domain.Car;
import validation.ValidationException;
import java.io.*;

/**
 * Чтение/запись автомобилей в CSV-файл.
 * Формат строки: power,model,year
 */
public final class FileCarRepository {
    private FileCarRepository() {}

    public static MyArrayList<Car> readCars(String path) throws IOException {
        if (path == null || path.isBlank()) {
            throw new IllegalArgumentException("Путь к файлу не должен быть пустым");
        }

        try (BufferedReader br = new BufferedReader(new FileReader(path))) {
            MyArrayList<Car> list = new MyArrayList<>();
            String line;
            int lineNo = 0;

            while ((line = br.readLine()) != null) {
                lineNo++;
                if (line.isBlank()) continue;

                try {
                    list.add(CarCsvParser.parseLine(line));
                } catch (ValidationException e) {
                    // добавляем номер строки — удобно для пользователя
                    throw new ValidationException("Ошибка в строке " + lineNo + ": " + e.getMessage());
                }
            }
            return list;
        }
    }

    /**
     * Запись в файл в режиме добавления
     */
    public static void appendCars(String path, MyArrayList<Car> cars) throws IOException {
        if (path == null || path.isBlank()) {
            throw new IllegalArgumentException("Путь к файлу не должен быть пустым");
        }
        if (cars == null) {
            throw new IllegalArgumentException("Коллекция автомобилей не должна быть пустой");
        }

        try (BufferedWriter bw = new BufferedWriter(new FileWriter(path, true))) {
            for (Car c : cars) {
                bw.write(CarCsvParser.toLine(c));
                bw.newLine();
            }
        }
    }
}
